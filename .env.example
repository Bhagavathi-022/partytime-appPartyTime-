# Copy this file to ".env" and fill in ONE of the keys below.

# OMDb (free, works for most networks): https://www.omdbapi.com/apikey.aspx
# Remember to click the activation link in the email OMDb sends you.
OMDB_API_KEY=

# TMDB (optional, gives trending and wide backdrops): https://www.themoviedb.org/settings/api
# Use the v3 "API Key". If both keys are set, TMDB is used.
TMDB_API_KEY=

# Port to run on
PORT=3000

# Optional: a TURN server makes voice chat work on strict networks (school, office, some mobile data).
# Example: TURN_URL=turn:your.turn.server:3478  (comma-separate several)
TURN_URL=
TURN_USER=
TURN_PASS=
